---
/**
 * The Stept mark — two bars on a 24×24 grid, the leading one stepped right and
 * down. The step is the product: the thing that just moved forward.
 *
 * Geometry is the source of truth in `assets/brand/` — reproduced here, never
 * redrawn. Keep in sync with `frontend/src/components/StepMark.tsx` and
 * `scripts/gen-brand-assets.mjs`.
 *
 * `split` (the default here) paints the leading bar with `--primary`, the
 * site's own indigo, which already lifts on dark surfaces — so the mark can
 * never drift out of step with the buttons and links beside it. The nav is a
 * front door and earns the colour. `mono` inherits the text colour for the
 * places the mark is furniture: the footer, in-page bylines.
 *
 * The wordmark is live HTML text in the site's self-hosted display face, not
 * the lockup SVG — sharper, selectable, one less font dependency.
 */
interface Props {
  size?: 'sm' | 'md' | 'lg'
  variant?: 'split' | 'mono'
  markOnly?: boolean
}
const { size = 'md', variant = 'split', markOnly = false } = Astro.props
const px = size === 'sm' ? 22 : size === 'lg' ? 34 : 27
---

<span class:list={['wm', `wm-${size}`, `wm-${variant}`]}>
  <svg
    class="wm-mark"
    width={px}
    height={px}
    viewBox="0 0 24 24"
    aria-hidden="true"
    focusable="false"
  >
    <rect x="3" y="3.5" width="15" height="7" rx="2.9" fill="currentColor"></rect>
    <rect class="wm-lead" x="6" y="13.5" width="15" height="7" rx="2.9" fill="currentColor"></rect>
  </svg>
  {!markOnly && <span class="wm-text">Stept</span>}
</span>

<style>
  .wm {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    color: var(--foreground);
  }
  .wm-mark {
    flex: none;
  }
  .wm-split .wm-lead {
    fill: var(--primary);
  }
  .wm-text {
    font-family: var(--font-display);
    font-weight: 700;
    letter-spacing: -0.035em;
    color: var(--foreground);
    line-height: 1;
  }
  .wm-sm .wm-text {
    font-size: 1.0625rem;
  }
  .wm-md .wm-text {
    font-size: 1.3125rem;
  }
  .wm-lg .wm-text {
    font-size: 1.625rem;
  }
</style>
