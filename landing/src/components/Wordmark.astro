---
/**
 * The Stept mark — building blocks with the last block set apart, taken from
 * the internal `stepped` app's post-login brand (its lucide `Blocks` lockup).
 * The detached block is filled: the step that just clicked into place.
 *
 * Inherits `currentColor` so it works on any background, legible at 16px.
 * Keep in sync with `frontend/src/components/StepMark.tsx`; regenerate the
 * favicons and OG image from this geometry, never redraw them.
 */
interface Props {
  size?: 'sm' | 'md' | 'lg'
  markOnly?: boolean
}
const { size = 'md', markOnly = false } = Astro.props
const px = size === 'sm' ? 22 : size === 'lg' ? 34 : 27
---

<span class:list={['wm', `wm-${size}`]}>
  <svg
    class="wm-mark"
    width={px}
    height={px}
    viewBox="0 0 24 24"
    fill="none"
    aria-hidden="true"
    focusable="false"
  >
    <path
      d="M10 21V8a1 1 0 0 0-1-1H4a1 1 0 0 0-1 1v12a1 1 0 0 0 1 1h12a1 1 0 0 0 1-1v-5a1 1 0 0 0-1-1H3"
      stroke="currentColor"
      stroke-width="2"
      stroke-linecap="round"
      stroke-linejoin="round"
    ></path>
    <rect x="14" y="3" width="7" height="7" rx="1.4" fill="currentColor"></rect>
  </svg>
  {!markOnly && <span class="wm-text">Stept</span>}
</span>

<style>
  .wm {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    color: var(--primary);
  }
  .wm-mark {
    flex: none;
  }
  .wm-text {
    font-family: var(--font-display);
    font-weight: 700;
    letter-spacing: -0.035em;
    color: var(--foreground);
    line-height: 1;
  }
  .wm-sm .wm-text {
    font-size: 1.0625rem;
  }
  .wm-md .wm-text {
    font-size: 1.3125rem;
  }
  .wm-lg .wm-text {
    font-size: 1.625rem;
  }
</style>
