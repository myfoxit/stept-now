interface Props {
  name: keyof typeof ICONS
  size?: number
  color?: boolean
}
const { name, size = 20, color = false } = Astro.props
const icon = ICONS[name]
---

{
  icon && (
    <svg
      role="img"
      aria-label={icon.title}
      width={size}
      height={size}
      viewBox={icon.viewBox}
      fill={color ? `#${icon.hex}` : 'currentColor'}
      focusable="false"
    >
      <path d={icon.path} />
    </svg>
  )
}
