---
/**
 * A real product screenshot in a browser chrome frame.
 *
 * The frame matters: an unframed UI screenshot on a white page reads as a
 * mockup, while the chrome tells the visitor "this is the running product".
 * Captured from the live app — see landing/public/shots/.
 */
interface Props {
  src: string
  alt: string
  url?: string
  priority?: boolean
}
const { src, alt, url = 'app.stepped.ai', priority = false } = Astro.props
---

<figure class="shot">
  <div class="shot-bar">
    <span class="dots"><i></i><i></i><i></i></span>
    <span class="url">{url}</span>
  </div>
  <img src={src} alt={alt} loading={priority ? 'eager' : 'lazy'} decoding="async" />
</figure>

<style>
  .shot {
    margin: 0;
    border: 1px solid var(--border);
    border-radius: calc(var(--radius) + 0.375rem);
    overflow: hidden;
    background: var(--card);
    box-shadow: var(--shadow-lg);
  }
  .shot-bar {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    height: 2.25rem;
    padding-inline: 0.85rem;
    background: var(--surface-2);
    border-bottom: 1px solid var(--border);
  }
  .dots {
    display: inline-flex;
    gap: 0.375rem;
    flex: none;
  }
  .dots i {
    width: 0.625rem;
    height: 0.625rem;
    border-radius: 50%;
    background: var(--border-strong);
  }
  .url {
    font-family: var(--font-mono);
    font-size: 0.6875rem;
    color: var(--muted-foreground);
    background: var(--background);
    border: 1px solid var(--border);
    border-radius: 999px;
    padding: 0.125rem 0.625rem;
  }
  .shot img {
    width: 100%;
    height: auto;
    display: block;
  }
</style>
