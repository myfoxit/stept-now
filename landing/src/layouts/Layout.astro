---
import '../styles/global.css'

interface Props {
  title?: string
  description?: string
}
const {
  title = 'Stept — the open-source Intercom + Fin alternative',
  description = 'Shared inbox, an AI agent that resolves on your own knowledge base, help center, product tours and automation. Self-host it free, or let us run it.',
} = Astro.props
const canonical = new URL(Astro.url.pathname, Astro.site)
const ogImage = new URL('/og.png', Astro.site)

// Stept's own widget, on Stept's own landing (dogfooding). The agent behind it
// answers from the same docs this site links to.
const WIDGET_KEY = 'wk_vgAm_r7hxJlm9KHVzTTz8owJ'
const APP_ORIGIN = 'https://app.stepped.ai'
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <meta name="theme-color" content="#ffffff" media="(prefers-color-scheme: light)" />
    <meta name="theme-color" content="#0a0a0a" media="(prefers-color-scheme: dark)" />

    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="Stept" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />

    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="icon" href="/favicon-32.png" type="image/png" sizes="32x32" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="sitemap" href="/sitemap.xml" />

    <script
      type="application/ld+json"
      set:html={JSON.stringify({
        '@context': 'https://schema.org',
        '@type': 'SoftwareApplication',
        name: 'Stept',
        applicationCategory: 'BusinessApplication',
        operatingSystem: 'Web, Self-hosted (Docker)',
        description,
        url: 'https://stepped.ai',
        offers: { '@type': 'Offer', price: '0', priceCurrency: 'USD' },
      })}
    />
  </head>
  <body>
    <slot />

    <script is:inline define:vars={{ WIDGET_KEY, APP_ORIGIN }}>
      window.SteptSettings = { workspaceKey: WIDGET_KEY, apiBase: APP_ORIGIN }
    </script>
    <script is:inline async src="https://app.stepped.ai/widget-assets/loader.js"></script>
  </body>
</html>
