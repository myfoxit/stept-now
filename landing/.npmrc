# Hoist deps to a flat node_modules. Astro's build pipeline imports a few CJS/ESM
# dual-package deps (clsx) by their named export; pnpm's isolated store can make
# Node resolve the CJS half and fail ("Named export 'clsx' not found"). A hoisted
# layout resolves them the way Astro expects. This project is standalone
# (installed with --ignore-workspace), so this does not affect the monorepo.
node-linker=hoisted
