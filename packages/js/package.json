{
  "name": "@stept/js",
  "version": "0.1.0",
  "description": "Embed the Stept messenger + AI assistant and teach it your app's actions in one line.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/myfoxit/stept-now",
    "directory": "packages/js"
  },
  "type": "module",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts"
  },
  "files": [
    "dist",
    "README.md"
  ],
  "sideEffects": false,
  "publishConfig": {
    "access": "public",
    "main": "./dist/index.js",
    "types": "./dist/index.d.ts",
    "exports": {
      ".": {
        "types": "./dist/index.d.ts",
        "import": "./dist/index.js"
      }
    }
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "build": "tsc -p tsconfig.build.json",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "devDependencies": {
    "jsdom": "^25.0.1",
    "typescript": "^5.7.2",
    "vitest": "^3.2.0"
  }
}
