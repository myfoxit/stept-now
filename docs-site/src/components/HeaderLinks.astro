---
/**
 * Replaces Starlight's social-icons slot so the docs header carries the same
 * links (and the same solid CTA) as the marketing site's nav.
 */
import Default from '@astrojs/starlight/components/SocialIcons.astro'
---

<div class="stept-header-links">
  <a class="link" href="https://stepped.ai">Website</a>
  <Default><slot /></Default>
  <a class="cta" href="https://app.stepped.ai/signup">Start free</a>
</div>

<style>
  .stept-header-links {
    display: flex;
    align-items: center;
    gap: 0.75rem;
  }
  .link {
    display: none;
    font-size: 0.875rem;
    color: var(--sl-color-gray-2);
    text-decoration: none;
  }
  .link:hover {
    color: var(--sl-color-white);
  }
  .cta {
    display: inline-flex;
    align-items: center;
    height: 2rem;
    padding-inline: 0.75rem;
    border-radius: 0.5rem;
    background: var(--sl-color-white);
    color: var(--sl-color-black);
    font-size: 0.8125rem;
    font-weight: 600;
    text-decoration: none;
    white-space: nowrap;
  }
  .cta:hover {
    opacity: 0.9;
  }
  @media (min-width: 50rem) {
    .link {
      display: inline;
    }
  }
</style>
