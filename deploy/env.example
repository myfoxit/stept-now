# /opt/stept/.env — production configuration.
#
# The deploy workflow renders this from GitHub secrets; keep this file as the
# canonical list of what the stack needs. Anything not set here falls back to the
# defaults in backend/app/core/config.py.
#
# env=prod refuses to start on a default/short secret key or a non-https base URL
# (app/core/config.py: assert_production_ready), so a half-filled file fails loud
# at boot rather than quietly signing tokens with a public constant.

# --- images (written by the deploy workflow, pinned to a commit sha) ---
API_IMAGE=ghcr.io/myfoxit/stept-now/api:<commit-sha>
WEB_IMAGE=ghcr.io/myfoxit/stept-now/web:<commit-sha>
LANDING_IMAGE=ghcr.io/myfoxit/stept-now/landing:<commit-sha>
DOCS_IMAGE=ghcr.io/myfoxit/stept-now/docs:<commit-sha>

# --- ingress ---
DOMAIN=stepped.ai
APP_DOMAIN=app.stepped.ai
SERVER_IP=178.104.12.226
ACME_EMAIL=alexander.hoehne@cancom.com

# --- secrets ---
# python -c 'import secrets; print(secrets.token_urlsafe(48))'
STEPT_SECRET_KEY=
POSTGRES_PASSWORD=
POSTGRES_USER=stept
POSTGRES_DB=stept

# --- app ---
STEPT_PUBLIC_BASE_URL=https://app.stepped.ai
STEPT_APP_BASE_URL=https://app.stepped.ai
STEPT_WEB_CONCURRENCY=4
# Proxies that append to X-Forwarded-For before the app sees it. 2 here:
# Cloudflare appends the visitor, Caddy appends Cloudflare. Get this wrong
# and the public rate limits either key on a Cloudflare edge IP (too low,
# limits stop working) or on a client-supplied value (too high, forgeable).
STEPT_TRUSTED_PROXY_HOPS=2
STEPT_MAX_UPLOAD_MB=25
STEPT_EMBEDDING_DIM=384
STEPT_EMAIL_FROM=Stept <no-reply@stepped.ai>

# Swagger UI and the OpenAPI document are off in prod by default. Setting this to
# true publishes a complete map of the API surface — leave it unset.
# STEPT_EXPOSE_API_DOCS=false

# --- social login (optional — empty ⇒ the buttons don't render) ---
# Redirect URIs to register:
#   https://app.stepped.ai/api/v1/auth/oauth/google/callback
#   https://app.stepped.ai/api/v1/auth/oauth/github/callback
# STEPT_GOOGLE_LOGIN_CLIENT_ID=
# STEPT_GOOGLE_LOGIN_CLIENT_SECRET=
# STEPT_GITHUB_CLIENT_ID=
# STEPT_GITHUB_CLIENT_SECRET=

# --- billing (optional — empty ⇒ billing disabled, everything entitled) ---
# Webhook endpoint to register in Stripe: https://app.stepped.ai/api/stripe/webhook
# STEPT_STRIPE_SECRET_KEY=
# STEPT_STRIPE_WEBHOOK_SECRET=
# STEPT_STRIPE_PUBLISHABLE_KEY=
# STEPT_STRIPE_PRICE_CLOUD=       # price id for $19/seat/mo
# STEPT_STRIPE_PRICE_BUSINESS=    # price id for $49/seat/mo

# --- outbound email (optional) ---
# STEPT_SMTP_HOST=
# STEPT_SMTP_PORT=587
# STEPT_SMTP_USER=
# STEPT_SMTP_PASSWORD=
# STEPT_SMTP_TLS=true

# AI provider keys are configured per-workspace in the UI and encrypted at rest
# with STEPT_SECRET_KEY — they do not belong in this file.
