# Stept production ingress — the box's single public entry point.
#
# Topology:
#   {$APP_DOMAIN}   app.stepped.ai   → the product: SPA from web, API from api
#   {$DOMAIN}       stepped.ai       → the marketing landing, with the API-owned
#                                      paths still proxied so old embed snippets
#                                      keep working, plus /poki/* handed to the
#                                      separately-deployed poki stack
#   docs.{$DOMAIN}  docs.stepped.ai  → the documentation site
#   www.{$DOMAIN}                    → redirect to the apex
#   https://{IP}                     → the app on a self-signed cert, so the box
#                                      stays reachable if DNS is broken
#
# ACME is HTTP-01; Cloudflare proxies these names but forwards port-80
# challenges, so issuance works either way. If a cert ever fails to renew,
# check that Cloudflare's "Always Use HTTPS" is off for /.well-known paths.
{
	email {$ACME_EMAIL}
	# A request to the raw IP over TLS gets a cert instead of an error.
	default_sni {$SERVER_IP}
}

# Transport-level headers only. Framing, referrer, nosniff and permissions are
# set by whoever actually produces the response, because only they know whether
# the path is meant to be embedded in a customer's site (the widget iframe, the
# help-center portal) — a blanket framing ban from out here would break those.
# API/portal responses: backend/app/main.py (security_headers_for).
# SPA + static responses: deploy/nginx.conf + deploy/nginx-static.conf.
(transport_headers) {
	header {
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		-Server
	}
}

# Every path the API owns. Kept in one snippet so the apex and the app domain
# cannot drift apart — a route that exists on one but not the other is how the
# widget ends up half-broken.
(stept_api_routes) {
	# WebSockets: dashboard realtime + widget realtime.
	@ws path /ws /ws/*
	handle @ws {
		reverse_proxy api:8600
	}

	# REST API, public help-center portal, recorder-extension downloads.
	@api path /api/* /portal/* /extension-assets/*
	handle @api {
		reverse_proxy api:8600 {
			# Uploads and knowledge ingestion can take a while.
			transport http {
				read_timeout 300s
			}
		}
	}

	# MCP: AI clients (Claude, Cursor, …) call workspace + browser-drive tools
	# here. Long-poll heavy — browser_run_tour legitimately holds the request
	# open for up to 15 minutes, so this cannot share @api's 300s budget.
	# The bare /mcp form matters: the backend 307-rewrites it to /mcp/ itself,
	# and MCP clients do not reliably follow redirects issued from out here.
	@mcp path /mcp /mcp/*
	handle @mcp {
		reverse_proxy api:8600 {
			transport http {
				read_timeout 960s
			}
		}
	}
}

# The product: API routes, then the dashboard SPA + widget bundle.
(stept_app) {
	import stept_api_routes

	handle {
		reverse_proxy web:80
	}
}

# ---- the app ----------------------------------------------------------------
{$APP_DOMAIN} {
	import transport_headers
	import stept_app
}

# ---- apex: the landing, with the app's public routes intact ------------------
{$DOMAIN} {
	import transport_headers

	# poki lives in its own compose project on the shared `stepped_stepped`
	# network and serves the whole /poki/ prefix itself (static Flutter build,
	# plus its own /poki/pb and /poki/tts backends), so pass the path through
	# unrewritten.
	handle /poki* {
		reverse_proxy poki-web:80
	}

	import stept_api_routes

	# The widget bundle stays fetchable from the apex so embed snippets that
	# ever pointed here keep working.
	@widget path /widget-assets/*
	handle @widget {
		reverse_proxy web:80
	}

	# Everything else is the marketing site.
	handle {
		reverse_proxy landing:80
	}
}

# ---- docs --------------------------------------------------------------------
docs.{$DOMAIN} {
	import transport_headers
	reverse_proxy docs:80
}

# ---- www convenience redirect ------------------------------------------------
www.{$DOMAIN} {
	redir https://{$DOMAIN}{uri} permanent
}

# ---- bare IP: reachable before/without DNS, self-signed cert -----------------
https://{$SERVER_IP} {
	tls internal
	import stept_app
}
