# Stept configuration — every variable is optional; defaults give a fully working
# zero-dependency dev setup (SQLite, in-memory queue/pubsub, mock AI, local storage).
# Copy to .env and adjust. All backend variables use the STEPT_ prefix.

# --- Core ---
STEPT_ENV=dev                          # dev | test | prod
STEPT_SECRET_KEY=change-me-in-prod     # signs JWTs, encrypts provider secrets (Fernet)
STEPT_BACKEND_PORT=8600
STEPT_PUBLIC_BASE_URL=http://localhost:8600   # where the API + widget assets are reachable
STEPT_APP_BASE_URL=http://localhost:5273      # the dashboard URL (CORS, links in emails)
STEPT_ALLOW_SIGNUP=true                # false ⇒ invite-only: uninvited registration is refused

# --- Database ---
# Zero-dep default: sqlite+aiosqlite:///./stept.db
# Full mode (docker compose up -d):
# STEPT_DATABASE_URL=postgresql+asyncpg://stept:stept@localhost:54329/stept

# --- Redis (optional; enables multi-process realtime + ARQ workers) ---
# STEPT_REDIS_URL=redis://localhost:63790/0

# --- Storage ---
STEPT_STORAGE_DIR=./data/uploads       # local storage root (S3 backend: see docs/self-hosting.md)
STEPT_MAX_UPLOAD_MB=25

# --- Email (outbound; Mailpit from docker compose for dev) ---
# STEPT_SMTP_HOST=localhost
# STEPT_SMTP_PORT=11025
# STEPT_SMTP_USER=
# STEPT_SMTP_PASSWORD=
# STEPT_SMTP_TLS=false
STEPT_EMAIL_FROM=Stept <no-reply@stept.local>

# --- AI ---
# Providers/models/keys are configured per-workspace in the UI (encrypted at rest).
# The deterministic mock provider is always available for offline dev/tests.
STEPT_EMBEDDING_DIM=384                # must match the embedding model you use workspace-wide

# --- Frontend (Vite; only needed when the API is not on localhost:8600) ---
# VITE_API_BASE_URL=http://localhost:8600
